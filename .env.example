# ===========================================
# CryptoAI.ai Platform Environment Variables
# ===========================================

# Application
NODE_ENV=development
APP_NAME=CryptoAI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptoai
REDIS_URL=redis://localhost:6379

# EMPIRE Module - TRDR Database
# PostgreSQL connection settings for the TRDR trading database
TRDR_DATABASE_HOST=localhost
TRDR_DATABASE_PORT=5432
TRDR_DATABASE_NAME=trdr
TRDR_DATABASE_USER=trdr_user
TRDR_DATABASE_PASSWORD=your-trdr-password-change-in-production
TRDR_DATABASE_URL=postgresql://trdr_user:your-trdr-password-change-in-production@localhost:5432/trdr
TRDR_DATABASE_POOL_MIN=2
TRDR_DATABASE_POOL_MAX=10
TRDR_DATABASE_SSL=false

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Blockchain
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-infura-key
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your-infura-key
PRIVATE_KEY=your-deployer-private-key

# KYC/AML Providers
SUMSUB_APP_TOKEN=your-sumsub-app-token
SUMSUB_SECRET_KEY=your-sumsub-secret-key
CHAINALYSIS_API_KEY=your-chainalysis-api-key

# Payment Providers
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
CIRCLE_API_KEY=your-circle-api-key

# Document Processing
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@cryptoai.ai

# Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=me-south-1
S3_BUCKET=cryptoai-documents

# UAE Integrations
UAE_PASS_CLIENT_ID=your-uae-pass-client-id
UAE_PASS_CLIENT_SECRET=your-uae-pass-secret

# Monitoring
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=debug
