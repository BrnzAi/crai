{
  "name": "cryptoai-platform",
  "version": "1.0.0",
  "description": "AI-Powered Tokenization Platform for Equity & Real Estate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate --filter=@cryptoai/database",
    "db:generate": "turbo run db:generate --filter=@cryptoai/database",
    "contracts:compile": "turbo run compile --filter=@cryptoai/contracts",
    "contracts:test": "turbo run test --filter=@cryptoai/contracts",
    "contracts:deploy": "turbo run deploy --filter=@cryptoai/contracts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.2.0"
}
